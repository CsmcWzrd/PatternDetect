        check value:1status OK_C0765_P05_S01 equals
        report "CASE 0765 PATTERN P05 HIT" match:file match:line value:1status
    ]

    P06: [
        title "Case 0765 pattern P06"
        within timestamp:1a + 2678400
        log message Component047 PDET_C0765_P06_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0765_P06_S00 equals
        report "CASE 0765 PATTERN P06 HIT" match:file match:line value:1status
