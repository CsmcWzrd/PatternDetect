{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0765 pattern P00"
        log message Component045 PDET_C0765_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0765_P00_S00 equals
        report "CASE 0765 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P04
        on-hit: P05
        on-hit: P06
        on-hit: P07
    ]

    P01: [
        title "Case 0765 pattern P01"
        within timestamp:1a + 2678400
        log message Component062 PDET_C0765_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component062 PDET_C0765_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component062 PDET_C0765_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0765_P01_S02 equals
        report "CASE 0765 PATTERN P01 HIT" match:file match:line value:1status
        on-hit: P02
    ]

    P02: [
        title "Case 0765 pattern P02"
        within timestamp:1a + 2678400
        log message Component079 PDET_C0765_P02_S00 separator " "
