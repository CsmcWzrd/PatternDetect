    P06: [
        title "Case 0242 pattern P06"
        within timestamp:1a + 2678400
        log message Component048 PDET_C0242_P06_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component048 PDET_C0242_P06_S01 separator " "
