        check value:1status OK_C0242_P04_S01 equals
        report "CASE 0242 PATTERN P04 HIT" match:file match:line value:1status
    ]

    P05: [
        title "Case 0242 pattern P05"
        within timestamp:1a + 2678400
        log message Component031 PDET_C0242_P05_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
