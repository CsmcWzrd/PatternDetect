{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0242 pattern P00"
        log message Component046 PDET_C0242_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component046 PDET_C0242_P00_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component046 PDET_C0242_P00_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0242_P00_S02 equals
        report "CASE 0242 PATTERN P00 HIT" match:file match:line value:1status
    ]

    P01: [
        title "Case 0242 pattern P01"
        within timestamp:1a + 2678400
        log message Component063 PDET_C0242_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component063 PDET_C0242_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0242_P01_S01 equals
        report "CASE 0242 PATTERN P01 HIT" match:file match:line value:1status
    ]

    P02: [
        title "Case 0242 pattern P02"
        within timestamp:1a + 2678400
        log message Component080 PDET_C0242_P02_S00 separator " "
