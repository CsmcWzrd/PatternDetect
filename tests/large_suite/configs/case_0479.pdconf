        grab timestamp:1a, value:1status, value:1tail@
        log message Component027 PDET_C0479_P00_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0479_P00_S02 equals
        report "CASE 0479 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P04
        on-hit: P05
        on-hit: P06
        on-hit: P07
        on-hit: P08
        on-hit: P09
