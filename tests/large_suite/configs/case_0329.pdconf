{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0329 pattern P00"
        log message Component077 PDET_C0329_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component077 PDET_C0329_P00_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component077 PDET_C0329_P00_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0329_P00_S02 equals
        report "CASE 0329 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P04
        on-hit: P05
        on-hit: P06
        on-hit: P07
        on-hit: P08
        on-hit: P09
