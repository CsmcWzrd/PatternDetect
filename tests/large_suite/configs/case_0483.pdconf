{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0483 pattern P00"
        log message Component079 PDET_C0483_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0483_P00_S00 equals
        report "CASE 0483 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P06
        on-hit: P07
    ]

    P01: [
        title "Case 0483 pattern P01"
        within timestamp:1a + 2678400
