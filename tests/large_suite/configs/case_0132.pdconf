{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0132 pattern P00"
        log message Component016 PDET_C0132_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0132_P00_S00 equals
        report "CASE 0132 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
    ]

    P01: [
        title "Case 0132 pattern P01"
        within timestamp:1a + 2678400
        log message Component033 PDET_C0132_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component033 PDET_C0132_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component033 PDET_C0132_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0132_P01_S02 equals
        report "CASE 0132 PATTERN P01 HIT" match:file match:line value:1status
        on-hit: P02
    ]

    P02: [
        title "Case 0132 pattern P02"
        within timestamp:1a + 2678400
        log message Component050 PDET_C0132_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component050 PDET_C0132_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0132_P02_S01 equals
        report "CASE 0132 PATTERN P02 HIT" match:file match:line value:1status
        on-hit: P03
    ]

    P03: [
        title "Case 0132 pattern P03"
        within timestamp:1a + 2678400
        log message Component067 PDET_C0132_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0132_P03_S00 equals
        report "CASE 0132 PATTERN P03 HIT" match:file match:line value:1status
        on-hit: P04
    ]

    P04: [
        title "Case 0132 pattern P04"
        within timestamp:1a + 2678400
        log message Component084 PDET_C0132_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component084 PDET_C0132_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component084 PDET_C0132_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0132_P04_S02 equals
        report "CASE 0132 PATTERN P04 HIT" match:file match:line value:1status
    ]

}
