    P07: [
        title "Case 0705 pattern P07"
        within timestamp:1a + 2678400
        log message Component084 PDET_C0705_P07_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component084 PDET_C0705_P07_S01 separator " "
