        log message Component033 PDET_C0705_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component033 PDET_C0705_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component033 PDET_C0705_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0705_P04_S02 equals
        report "CASE 0705 PATTERN P04 HIT" match:file match:line value:1status
        on-hit: P05
    ]

    P05: [
        title "Case 0705 pattern P05"
        within timestamp:1a + 2678400
        log message Component050 PDET_C0705_P05_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component050 PDET_C0705_P05_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0705_P05_S01 equals
        report "CASE 0705 PATTERN P05 HIT" match:file match:line value:1status
        on-hit: P06
    ]

    P06: [
        title "Case 0705 pattern P06"
        within timestamp:1a + 2678400
        log message Component067 PDET_C0705_P06_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0705_P06_S00 equals
        report "CASE 0705 PATTERN P06 HIT" match:file match:line value:1status
