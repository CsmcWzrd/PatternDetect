{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0096 pattern P00"
        log message Component048 PDET_C0096_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0096_P00_S00 equals
        report "CASE 0096 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P03
        on-hit: P04
    ]

    P01: [
        title "Case 0096 pattern P01"
        within timestamp:1a + 2678400
        log message Component065 PDET_C0096_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component065 PDET_C0096_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component065 PDET_C0096_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component065 PDET_C0096_P01_S03 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component065 PDET_C0096_P01_S04 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component065 PDET_C0096_P01_S05 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component065 PDET_C0096_P01_S06 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component065 PDET_C0096_P01_S07 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component065 PDET_C0096_P01_S08 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component065 PDET_C0096_P01_S09 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0096_P01_S09 equals
        report "CASE 0096 PATTERN P01 HIT" match:file match:line value:1status
        on-hit: P02
    ]

    P02: [
        title "Case 0096 pattern P02"
        within timestamp:1a + 2678400
        log message Component082 PDET_C0096_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component082 PDET_C0096_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0096_P02_S01 equals
        report "CASE 0096 PATTERN P02 HIT" match:file match:line value:1status
    ]

    P03: [
        title "Case 0096 pattern P03"
        within timestamp:1a + 2678400
        log message Component099 PDET_C0096_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0096_P03_S00 equals
        report "CASE 0096 PATTERN P03 HIT" match:file match:line value:1status
    ]

    P04: [
        title "Case 0096 pattern P04"
        within timestamp:1a + 2678400
        log message Component016 PDET_C0096_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component016 PDET_C0096_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component016 PDET_C0096_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0096_P04_S02 equals
        report "CASE 0096 PATTERN P04 HIT" match:file match:line value:1status
    ]

}
