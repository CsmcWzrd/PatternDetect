        report "CASE 0230 PATTERN P04 HIT" match:file match:line value:1status
    ]

    P05: [
        title "Case 0230 pattern P05"
        within timestamp:1a + 2678400
        log message Component075 PDET_C0230_P05_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
