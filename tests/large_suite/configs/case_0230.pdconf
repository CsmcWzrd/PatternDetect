    P06: [
        title "Case 0230 pattern P06"
        within timestamp:1a + 2678400
        log message Component092 PDET_C0230_P06_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component092 PDET_C0230_P06_S01 separator " "
