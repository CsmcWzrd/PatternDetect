{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0774 pattern P00"
        log message Component062 PDET_C0774_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0774_P00_S00 equals
        report "CASE 0774 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P04
    ]

    P01: [
        title "Case 0774 pattern P01"
        within timestamp:1a + 2678400
        log message Component079 PDET_C0774_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component079 PDET_C0774_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component079 PDET_C0774_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0774_P01_S02 equals
        report "CASE 0774 PATTERN P01 HIT" match:file match:line value:1status
        on-hit: P02
    ]

    P02: [
        title "Case 0774 pattern P02"
        within timestamp:1a + 2678400
        log message Component096 PDET_C0774_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component096 PDET_C0774_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component096 PDET_C0774_P02_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component096 PDET_C0774_P02_S03 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component096 PDET_C0774_P02_S04 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component096 PDET_C0774_P02_S05 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component096 PDET_C0774_P02_S06 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component096 PDET_C0774_P02_S07 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component096 PDET_C0774_P02_S08 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component096 PDET_C0774_P02_S09 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0774_P02_S09 equals
        report "CASE 0774 PATTERN P02 HIT" match:file match:line value:1status
        on-hit: P03
    ]

    P03: [
        title "Case 0774 pattern P03"
        within timestamp:1a + 2678400
        log message Component013 PDET_C0774_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0774_P03_S00 equals
        report "CASE 0774 PATTERN P03 HIT" match:file match:line value:1status
    ]

    P04: [
        title "Case 0774 pattern P04"
        within timestamp:1a + 2678400
        log message Component030 PDET_C0774_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component030 PDET_C0774_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component030 PDET_C0774_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0774_P04_S02 equals
        report "CASE 0774 PATTERN P04 HIT" match:file match:line value:1status
    ]

}
