{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0493 pattern P00"
        log message Component009 PDET_C0493_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component009 PDET_C0493_P00_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0493_P00_S01 equals
        report "CASE 0493 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P02
        on-hit: P03
        on-hit: P04
        on-hit: P05
    ]

    P01: [
        title "Case 0493 pattern P01"
        within timestamp:1a + 2678400
        log message Component026 PDET_C0493_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0493_P01_S00 equals
        report "CASE 0493 PATTERN P01 HIT" match:file match:line value:1status
    ]

    P02: [
        title "Case 0493 pattern P02"
        within timestamp:1a + 2678400
        log message Component043 PDET_C0493_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component043 PDET_C0493_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component043 PDET_C0493_P02_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0493_P02_S02 equals
        report "CASE 0493 PATTERN P02 HIT" match:file match:line value:1status
    ]

    P03: [
        title "Case 0493 pattern P03"
        within timestamp:1a + 2678400
        log message Component060 PDET_C0493_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component060 PDET_C0493_P03_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0493_P03_S01 equals
        report "CASE 0493 PATTERN P03 HIT" match:file match:line value:1status
    ]

    P04: [
        title "Case 0493 pattern P04"
        within timestamp:1a + 2678400
        log message Component077 PDET_C0493_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0493_P04_S00 equals
        report "CASE 0493 PATTERN P04 HIT" match:file match:line value:1status
    ]

    P05: [
        title "Case 0493 pattern P05"
        within timestamp:1a + 2678400
        log message Component094 PDET_C0493_P05_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component094 PDET_C0493_P05_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component094 PDET_C0493_P05_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0493_P05_S02 equals
        report "CASE 0493 PATTERN P05 HIT" match:file match:line value:1status
    ]

}
