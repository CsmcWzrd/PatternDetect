        log message Component073 PDET_C0303_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0303_P02_S01 equals
        report "CASE 0303 PATTERN P02 HIT" match:file match:line value:1status
    ]

    P03: [
        title "Case 0303 pattern P03"
        within timestamp:1a + 2678400
        log message Component090 PDET_C0303_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0303_P03_S00 equals
        report "CASE 0303 PATTERN P03 HIT" match:file match:line value:1status
    ]

    P04: [
        title "Case 0303 pattern P04"
        within timestamp:1a + 2678400
        log message Component007 PDET_C0303_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component007 PDET_C0303_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component007 PDET_C0303_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0303_P04_S02 equals
        report "CASE 0303 PATTERN P04 HIT" match:file match:line value:1status
    ]

    P05: [
        title "Case 0303 pattern P05"
        within timestamp:1a + 2678400
        log message Component024 PDET_C0303_P05_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component024 PDET_C0303_P05_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0303_P05_S01 equals
        report "CASE 0303 PATTERN P05 HIT" match:file match:line value:1status
    ]

    P06: [
        title "Case 0303 pattern P06"
        within timestamp:1a + 2678400
        log message Component041 PDET_C0303_P06_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0303_P06_S00 equals
        report "CASE 0303 PATTERN P06 HIT" match:file match:line value:1status
    ]

    P07: [
        title "Case 0303 pattern P07"
        within timestamp:1a + 2678400
        log message Component058 PDET_C0303_P07_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component058 PDET_C0303_P07_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
