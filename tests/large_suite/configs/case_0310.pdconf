{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0310 pattern P00"
        log message Component030 PDET_C0310_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component030 PDET_C0310_P00_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0310_P00_S01 equals
        report "CASE 0310 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P02
        on-hit: P03
        on-hit: P04
        on-hit: P05
        on-hit: P06
        on-hit: P07
        on-hit: P08
    ]

    P01: [
        title "Case 0310 pattern P01"
        within timestamp:1a + 2678400
        log message Component047 PDET_C0310_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0310_P01_S00 equals
        report "CASE 0310 PATTERN P01 HIT" match:file match:line value:1status
    ]

