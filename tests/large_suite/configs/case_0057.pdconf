        grab timestamp:1a, value:1status, value:1tail@
        log message Component009 PDET_C0057_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component009 PDET_C0057_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0057_P04_S02 equals
        report "CASE 0057 PATTERN P04 HIT" match:file match:line value:1status
        on-hit: P05
