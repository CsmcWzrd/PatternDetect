        check value:1status OK_C0057_P05_S01 equals
        report "CASE 0057 PATTERN P05 HIT" match:file match:line value:1status
        on-hit: P06
    ]

    P06: [
        title "Case 0057 pattern P06"
        within timestamp:1a + 2678400
        log message Component043 PDET_C0057_P06_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0057_P06_S00 equals
        report "CASE 0057 PATTERN P06 HIT" match:file match:line value:1status
