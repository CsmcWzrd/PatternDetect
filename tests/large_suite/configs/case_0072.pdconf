{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0072 pattern P00"
        log message Component036 PDET_C0072_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0072_P00_S00 equals
        report "CASE 0072 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
    ]

    P01: [
        title "Case 0072 pattern P01"
        within timestamp:1a + 2678400
        log message Component053 PDET_C0072_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component053 PDET_C0072_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component053 PDET_C0072_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0072_P01_S02 equals
        report "CASE 0072 PATTERN P01 HIT" match:file match:line value:1status
        on-hit: P02
    ]

    P02: [
        title "Case 0072 pattern P02"
        within timestamp:1a + 2678400
        log message Component070 PDET_C0072_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component070 PDET_C0072_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0072_P02_S01 equals
        report "CASE 0072 PATTERN P02 HIT" match:file match:line value:1status
        on-hit: P03
    ]

    P03: [
        title "Case 0072 pattern P03"
        within timestamp:1a + 2678400
        log message Component087 PDET_C0072_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0072_P03_S00 equals
        report "CASE 0072 PATTERN P03 HIT" match:file match:line value:1status
        on-hit: P04
    ]

    P04: [
        title "Case 0072 pattern P04"
        within timestamp:1a + 2678400
        log message Component004 PDET_C0072_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component004 PDET_C0072_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component004 PDET_C0072_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0072_P04_S02 equals
        report "CASE 0072 PATTERN P04 HIT" match:file match:line value:1status
    ]

}
