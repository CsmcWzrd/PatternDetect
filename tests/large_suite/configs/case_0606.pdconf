{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0606 pattern P00"
        log message Component078 PDET_C0606_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0606_P00_S00 equals
        report "CASE 0606 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P03
        on-hit: P04
    ]

    P01: [
        title "Case 0606 pattern P01"
        within timestamp:1a + 2678400
        log message Component095 PDET_C0606_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component095 PDET_C0606_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component095 PDET_C0606_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0606_P01_S02 equals
        report "CASE 0606 PATTERN P01 HIT" match:file match:line value:1status
        on-hit: P02
    ]

    P02: [
        title "Case 0606 pattern P02"
        within timestamp:1a + 2678400
        log message Component012 PDET_C0606_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component012 PDET_C0606_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0606_P02_S01 equals
        report "CASE 0606 PATTERN P02 HIT" match:file match:line value:1status
    ]

    P03: [
        title "Case 0606 pattern P03"
        within timestamp:1a + 2678400
        log message Component029 PDET_C0606_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0606_P03_S00 equals
        report "CASE 0606 PATTERN P03 HIT" match:file match:line value:1status
    ]

    P04: [
        title "Case 0606 pattern P04"
        within timestamp:1a + 2678400
        log message Component046 PDET_C0606_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component046 PDET_C0606_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component046 PDET_C0606_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0606_P04_S02 equals
        report "CASE 0606 PATTERN P04 HIT" match:file match:line value:1status
    ]

}
