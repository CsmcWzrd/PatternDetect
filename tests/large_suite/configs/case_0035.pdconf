{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0035 pattern P00"
        log message Component055 PDET_C0035_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component055 PDET_C0035_P00_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component055 PDET_C0035_P00_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0035_P00_S02 equals
        report "CASE 0035 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P06
        on-hit: P07
        on-hit: P08
        on-hit: P09
    ]

    P01: [
        title "Case 0035 pattern P01"
        within timestamp:1a + 2678400
        log message Component072 PDET_C0035_P01_S00 separator " "
