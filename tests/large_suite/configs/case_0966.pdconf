{
    use chronological-order
    use report-destination terminal

    P00: [
        title "Case 0966 pattern P00"
        log message Component058 PDET_C0966_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0966_P00_S00 equals
        report "CASE 0966 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P03
        on-hit: P04
    ]

    P01: [
        title "Case 0966 pattern P01"
        within timestamp:1a + 2678400
        log message Component075 PDET_C0966_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component075 PDET_C0966_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component075 PDET_C0966_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0966_P01_S02 equals
        report "CASE 0966 PATTERN P01 HIT" match:file match:line value:1status
        on-hit: P02
    ]

    P02: [
        title "Case 0966 pattern P02"
        within timestamp:1a + 2678400
        log message Component092 PDET_C0966_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component092 PDET_C0966_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0966_P02_S01 equals
        report "CASE 0966 PATTERN P02 HIT" match:file match:line value:1status
    ]

    P03: [
        title "Case 0966 pattern P03"
        within timestamp:1a + 2678400
        log message Component009 PDET_C0966_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0966_P03_S00 equals
        report "CASE 0966 PATTERN P03 HIT" match:file match:line value:1status
    ]

    P04: [
        title "Case 0966 pattern P04"
        within timestamp:1a + 2678400
        log message Component026 PDET_C0966_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component026 PDET_C0966_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component026 PDET_C0966_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component026 PDET_C0966_P04_S03 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component026 PDET_C0966_P04_S04 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component026 PDET_C0966_P04_S05 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component026 PDET_C0966_P04_S06 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component026 PDET_C0966_P04_S07 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component026 PDET_C0966_P04_S08 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component026 PDET_C0966_P04_S09 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0966_P04_S09 equals
        report "CASE 0966 PATTERN P04 HIT" match:file match:line value:1status
    ]

}
