{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0126 pattern P00"
        log message Component038 PDET_C0126_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0126_P00_S00 equals
        report "CASE 0126 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P03
        on-hit: P04
    ]

    P01: [
        title "Case 0126 pattern P01"
        within timestamp:1a + 2678400
        log message Component055 PDET_C0126_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component055 PDET_C0126_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component055 PDET_C0126_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0126_P01_S02 equals
        report "CASE 0126 PATTERN P01 HIT" match:file match:line value:1status
        on-hit: P02
    ]

    P02: [
        title "Case 0126 pattern P02"
        within timestamp:1a + 2678400
        log message Component072 PDET_C0126_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component072 PDET_C0126_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0126_P02_S01 equals
        report "CASE 0126 PATTERN P02 HIT" match:file match:line value:1status
    ]

    P03: [
        title "Case 0126 pattern P03"
        within timestamp:1a + 2678400
        log message Component089 PDET_C0126_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0126_P03_S00 equals
        report "CASE 0126 PATTERN P03 HIT" match:file match:line value:1status
    ]

    P04: [
        title "Case 0126 pattern P04"
        within timestamp:1a + 2678400
        log message Component006 PDET_C0126_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component006 PDET_C0126_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component006 PDET_C0126_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0126_P04_S02 equals
        report "CASE 0126 PATTERN P04 HIT" match:file match:line value:1status
    ]

}
