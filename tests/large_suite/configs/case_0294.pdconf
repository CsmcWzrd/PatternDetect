{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0294 pattern P00"
        log message Component022 PDET_C0294_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0294_P00_S00 equals
        report "CASE 0294 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P04
    ]

    P01: [
        title "Case 0294 pattern P01"
        within timestamp:1a + 2678400
        log message Component039 PDET_C0294_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component039 PDET_C0294_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component039 PDET_C0294_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0294_P01_S02 equals
        report "CASE 0294 PATTERN P01 HIT" match:file match:line value:1status
        on-hit: P02
    ]

    P02: [
        title "Case 0294 pattern P02"
        within timestamp:1a + 2678400
        log message Component056 PDET_C0294_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component056 PDET_C0294_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0294_P02_S01 equals
        report "CASE 0294 PATTERN P02 HIT" match:file match:line value:1status
        on-hit: P03
    ]

    P03: [
        title "Case 0294 pattern P03"
        within timestamp:1a + 2678400
        log message Component073 PDET_C0294_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0294_P03_S00 equals
        report "CASE 0294 PATTERN P03 HIT" match:file match:line value:1status
    ]

    P04: [
        title "Case 0294 pattern P04"
        within timestamp:1a + 2678400
        log message Component090 PDET_C0294_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component090 PDET_C0294_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component090 PDET_C0294_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0294_P04_S02 equals
        report "CASE 0294 PATTERN P04 HIT" match:file match:line value:1status
    ]

}
