{
    use chronological-order
    use report-destination terminal

    P00: [
        title "Case 0000 pattern P00"
        log message Component000 PDET_C0000_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component000 PDET_C0000_P00_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component000 PDET_C0000_P00_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component000 PDET_C0000_P00_S03 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component000 PDET_C0000_P00_S04 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component000 PDET_C0000_P00_S05 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component000 PDET_C0000_P00_S06 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component000 PDET_C0000_P00_S07 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component000 PDET_C0000_P00_S08 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component000 PDET_C0000_P00_S09 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0000_P00_S09 equals
        report "CASE 0000 PATTERN P00 HIT" match:file match:line value:1status
    ]

    P01: [
        title "Case 0000 pattern P01"
        within timestamp:1a + 2678400
        log message Component017 PDET_C0000_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component017 PDET_C0000_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component017 PDET_C0000_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0000_P01_S02 equals
        report "CASE 0000 PATTERN P01 HIT" match:file match:line value:1status
    ]

    P02: [
        title "Case 0000 pattern P02"
        within timestamp:1a + 2678400
        log message Component034 PDET_C0000_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component034 PDET_C0000_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0000_P02_S01 equals
        report "CASE 0000 PATTERN P02 HIT" match:file match:line value:1status
    ]

    P03: [
        title "Case 0000 pattern P03"
        within timestamp:1a + 2678400
        log message Component051 PDET_C0000_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0000_P03_S00 equals
        report "CASE 0000 PATTERN P03 HIT" match:file match:line value:1status
    ]

    P04: [
        title "Case 0000 pattern P04"
        within timestamp:1a + 2678400
        log message Component068 PDET_C0000_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component068 PDET_C0000_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component068 PDET_C0000_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0000_P04_S02 equals
        report "CASE 0000 PATTERN P04 HIT" match:file match:line value:1status
    ]

}
