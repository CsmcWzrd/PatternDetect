{
    use chronological-order
    use report-destination terminal

    P00: [
        title "Case 0466 pattern P00"
        log message Component058 PDET_C0466_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component058 PDET_C0466_P00_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0466_P00_S01 equals
        report "CASE 0466 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P05
        on-hit: P06
        on-hit: P07
        on-hit: P08
    ]

    P01: [
        title "Case 0466 pattern P01"
