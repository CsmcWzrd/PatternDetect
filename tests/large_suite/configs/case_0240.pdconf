{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0240 pattern P00"
        log message Component020 PDET_C0240_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0240_P00_S00 equals
        report "CASE 0240 PATTERN P00 HIT" match:file match:line value:1status
    ]

    P01: [
        title "Case 0240 pattern P01"
        within timestamp:1a + 2678400
        log message Component037 PDET_C0240_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component037 PDET_C0240_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component037 PDET_C0240_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0240_P01_S02 equals
        report "CASE 0240 PATTERN P01 HIT" match:file match:line value:1status
    ]

    P02: [
        title "Case 0240 pattern P02"
        within timestamp:1a + 2678400
        log message Component054 PDET_C0240_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component054 PDET_C0240_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0240_P02_S01 equals
        report "CASE 0240 PATTERN P02 HIT" match:file match:line value:1status
    ]

    P03: [
        title "Case 0240 pattern P03"
        within timestamp:1a + 2678400
        log message Component071 PDET_C0240_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0240_P03_S00 equals
        report "CASE 0240 PATTERN P03 HIT" match:file match:line value:1status
    ]

    P04: [
        title "Case 0240 pattern P04"
        within timestamp:1a + 2678400
        log message Component088 PDET_C0240_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component088 PDET_C0240_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component088 PDET_C0240_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0240_P04_S02 equals
        report "CASE 0240 PATTERN P04 HIT" match:file match:line value:1status
    ]

}
