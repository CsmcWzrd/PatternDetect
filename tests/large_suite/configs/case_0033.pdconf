{
    use chronological-order
    use report-destination terminal

    P00: [
        title "Case 0033 pattern P00"
        log message Component029 PDET_C0033_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0033_P00_S00 equals
        report "CASE 0033 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
    ]

    P01: [
        title "Case 0033 pattern P01"
        within timestamp:1a + 2678400
        log message Component046 PDET_C0033_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component046 PDET_C0033_P01_S01 separator " "
