        grab timestamp:1a, value:1status, value:1tail@
        log message Component095 PDET_C0288_P03_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component095 PDET_C0288_P03_S03 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component095 PDET_C0288_P03_S04 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component095 PDET_C0288_P03_S05 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component095 PDET_C0288_P03_S06 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component095 PDET_C0288_P03_S07 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component095 PDET_C0288_P03_S08 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component095 PDET_C0288_P03_S09 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0288_P03_S09 equals
        report "CASE 0288 PATTERN P03 HIT" match:file match:line value:1status
    ]

    P04: [
        title "Case 0288 pattern P04"
        within timestamp:1a + 2678400
        log message Component012 PDET_C0288_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component012 PDET_C0288_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component012 PDET_C0288_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0288_P04_S02 equals
        report "CASE 0288 PATTERN P04 HIT" match:file match:line value:1status
    ]

}
