{
    use chronological-order
    use report-destination terminal

    P00: [
        title "Case 0288 pattern P00"
        log message Component044 PDET_C0288_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0288_P00_S00 equals
        report "CASE 0288 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P02
        on-hit: P03
        on-hit: P04
    ]

    P01: [
        title "Case 0288 pattern P01"
        within timestamp:1a + 2678400
        log message Component061 PDET_C0288_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component061 PDET_C0288_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component061 PDET_C0288_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0288_P01_S02 equals
        report "CASE 0288 PATTERN P01 HIT" match:file match:line value:1status
    ]

    P02: [
        title "Case 0288 pattern P02"
        within timestamp:1a + 2678400
        log message Component078 PDET_C0288_P02_S00 separator " "
