        log message Component022 PDET_C0694_P00_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0694_P00_S01 equals
        report "CASE 0694 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P08
    ]

