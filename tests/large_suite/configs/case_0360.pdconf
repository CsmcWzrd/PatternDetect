{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0360 pattern P00"
        log message Component080 PDET_C0360_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0360_P00_S00 equals
        report "CASE 0360 PATTERN P00 HIT" match:file match:line value:1status
    ]

    P01: [
        title "Case 0360 pattern P01"
        within timestamp:1a + 2678400
        log message Component097 PDET_C0360_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component097 PDET_C0360_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component097 PDET_C0360_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0360_P01_S02 equals
        report "CASE 0360 PATTERN P01 HIT" match:file match:line value:1status
    ]

    P02: [
        title "Case 0360 pattern P02"
        within timestamp:1a + 2678400
        log message Component014 PDET_C0360_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component014 PDET_C0360_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component014 PDET_C0360_P02_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component014 PDET_C0360_P02_S03 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component014 PDET_C0360_P02_S04 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component014 PDET_C0360_P02_S05 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component014 PDET_C0360_P02_S06 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0360_P02_S06 equals
        report "CASE 0360 PATTERN P02 HIT" match:file match:line value:1status
    ]

    P03: [
        title "Case 0360 pattern P03"
        within timestamp:1a + 2678400
        log message Component031 PDET_C0360_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0360_P03_S00 equals
        report "CASE 0360 PATTERN P03 HIT" match:file match:line value:1status
    ]

    P04: [
        title "Case 0360 pattern P04"
        within timestamp:1a + 2678400
        log message Component048 PDET_C0360_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component048 PDET_C0360_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component048 PDET_C0360_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0360_P04_S02 equals
        report "CASE 0360 PATTERN P04 HIT" match:file match:line value:1status
    ]

}
