{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0918 pattern P00"
        log message Component034 PDET_C0918_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0918_P00_S00 equals
        report "CASE 0918 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P02
        on-hit: P03
        on-hit: P04
    ]

    P01: [
        title "Case 0918 pattern P01"
        within timestamp:1a + 2678400
        log message Component051 PDET_C0918_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component051 PDET_C0918_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component051 PDET_C0918_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0918_P01_S02 equals
        report "CASE 0918 PATTERN P01 HIT" match:file match:line value:1status
    ]

    P02: [
        title "Case 0918 pattern P02"
        within timestamp:1a + 2678400
        log message Component068 PDET_C0918_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component068 PDET_C0918_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0918_P02_S01 equals
        report "CASE 0918 PATTERN P02 HIT" match:file match:line value:1status
    ]

    P03: [
        title "Case 0918 pattern P03"
        within timestamp:1a + 2678400
        log message Component085 PDET_C0918_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0918_P03_S00 equals
        report "CASE 0918 PATTERN P03 HIT" match:file match:line value:1status
    ]

    P04: [
        title "Case 0918 pattern P04"
        within timestamp:1a + 2678400
        log message Component002 PDET_C0918_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component002 PDET_C0918_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component002 PDET_C0918_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0918_P04_S02 equals
        report "CASE 0918 PATTERN P04 HIT" match:file match:line value:1status
    ]

}
