        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0975_P04_S02 equals
        report "CASE 0975 PATTERN P04 HIT" match:file match:line value:1status
    ]

    P05: [
        title "Case 0975 pattern P05"
        within timestamp:1a + 2678400
