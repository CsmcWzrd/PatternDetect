        check value:1status OK_C0975_P02_S01 equals
        report "CASE 0975 PATTERN P02 HIT" match:file match:line value:1status
    ]

    P03: [
        title "Case 0975 pattern P03"
        within timestamp:1a + 2678400
        log message Component026 PDET_C0975_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
