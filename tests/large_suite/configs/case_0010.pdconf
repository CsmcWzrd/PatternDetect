{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0010 pattern P00"
        log message Component030 PDET_C0010_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component030 PDET_C0010_P00_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0010_P00_S01 equals
        report "CASE 0010 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P08
    ]

    P01: [
        title "Case 0010 pattern P01"
        within timestamp:1a + 2678400
        log message Component047 PDET_C0010_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0010_P01_S00 equals
        report "CASE 0010 PATTERN P01 HIT" match:file match:line value:1status
        on-hit: P02
    ]

