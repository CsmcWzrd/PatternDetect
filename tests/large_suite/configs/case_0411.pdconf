{
    use chronological-order
    use report-destination terminal

    P00: [
        title "Case 0411 pattern P00"
        log message Component043 PDET_C0411_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0411_P00_S00 equals
        report "CASE 0411 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P06
        on-hit: P07
    ]

    P01: [
        title "Case 0411 pattern P01"
        within timestamp:1a + 2678400
        log message Component060 PDET_C0411_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component060 PDET_C0411_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component060 PDET_C0411_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0411_P01_S02 equals
        report "CASE 0411 PATTERN P01 HIT" match:file match:line value:1status
        on-hit: P02
    ]

    P02: [
        title "Case 0411 pattern P02"
        within timestamp:1a + 2678400
        log message Component077 PDET_C0411_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component077 PDET_C0411_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0411_P02_S01 equals
        report "CASE 0411 PATTERN P02 HIT" match:file match:line value:1status
        on-hit: P03
    ]

    P03: [
        title "Case 0411 pattern P03"
        within timestamp:1a + 2678400
        log message Component094 PDET_C0411_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0411_P03_S00 equals
        report "CASE 0411 PATTERN P03 HIT" match:file match:line value:1status
        on-hit: P04
    ]

    P04: [
        title "Case 0411 pattern P04"
        within timestamp:1a + 2678400
        log message Component011 PDET_C0411_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component011 PDET_C0411_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component011 PDET_C0411_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0411_P04_S02 equals
        report "CASE 0411 PATTERN P04 HIT" match:file match:line value:1status
        on-hit: P05
    ]

    P05: [
        title "Case 0411 pattern P05"
        within timestamp:1a + 2678400
        log message Component028 PDET_C0411_P05_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component028 PDET_C0411_P05_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0411_P05_S01 equals
        report "CASE 0411 PATTERN P05 HIT" match:file match:line value:1status
    ]

    P06: [
        title "Case 0411 pattern P06"
        within timestamp:1a + 2678400
        log message Component045 PDET_C0411_P06_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0411_P06_S00 equals
        report "CASE 0411 PATTERN P06 HIT" match:file match:line value:1status
    ]

    P07: [
        title "Case 0411 pattern P07"
        within timestamp:1a + 2678400
        log message Component062 PDET_C0411_P07_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component062 PDET_C0411_P07_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component062 PDET_C0411_P07_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0411_P07_S02 equals
        report "CASE 0411 PATTERN P07 HIT" match:file match:line value:1status
    ]

}
