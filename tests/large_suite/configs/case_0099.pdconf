{
    use chronological-order
    use report-destination terminal

    P00: [
        title "Case 0099 pattern P00"
        log message Component087 PDET_C0099_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0099_P00_S00 equals
        report "CASE 0099 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P06
        on-hit: P07
    ]

    P01: [
        title "Case 0099 pattern P01"
        within timestamp:1a + 2678400
        log message Component004 PDET_C0099_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component004 PDET_C0099_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component004 PDET_C0099_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0099_P01_S02 equals
        report "CASE 0099 PATTERN P01 HIT" match:file match:line value:1status
        on-hit: P02
    ]

    P02: [
        title "Case 0099 pattern P02"
        within timestamp:1a + 2678400
        log message Component021 PDET_C0099_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component021 PDET_C0099_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0099_P02_S01 equals
        report "CASE 0099 PATTERN P02 HIT" match:file match:line value:1status
        on-hit: P03
    ]

    P03: [
        title "Case 0099 pattern P03"
        within timestamp:1a + 2678400
        log message Component038 PDET_C0099_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0099_P03_S00 equals
        report "CASE 0099 PATTERN P03 HIT" match:file match:line value:1status
        on-hit: P04
    ]

    P04: [
        title "Case 0099 pattern P04"
        within timestamp:1a + 2678400
        log message Component055 PDET_C0099_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component055 PDET_C0099_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component055 PDET_C0099_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0099_P04_S02 equals
        report "CASE 0099 PATTERN P04 HIT" match:file match:line value:1status
        on-hit: P05
    ]

    P05: [
        title "Case 0099 pattern P05"
        within timestamp:1a + 2678400
        log message Component072 PDET_C0099_P05_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component072 PDET_C0099_P05_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0099_P05_S01 equals
        report "CASE 0099 PATTERN P05 HIT" match:file match:line value:1status
    ]

    P06: [
        title "Case 0099 pattern P06"
        within timestamp:1a + 2678400
        log message Component089 PDET_C0099_P06_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0099_P06_S00 equals
        report "CASE 0099 PATTERN P06 HIT" match:file match:line value:1status
    ]

    P07: [
        title "Case 0099 pattern P07"
        within timestamp:1a + 2678400
        log message Component006 PDET_C0099_P07_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component006 PDET_C0099_P07_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component006 PDET_C0099_P07_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
