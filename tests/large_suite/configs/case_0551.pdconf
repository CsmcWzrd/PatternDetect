{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0551 pattern P00"
        log message Component063 PDET_C0551_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component063 PDET_C0551_P00_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component063 PDET_C0551_P00_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0551_P00_S02 equals
        report "CASE 0551 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P08
        on-hit: P09
    ]

    P01: [
        title "Case 0551 pattern P01"
        within timestamp:1a + 2678400
