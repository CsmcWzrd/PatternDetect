        log message Component001 PDET_C0677_P00_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component001 PDET_C0677_P00_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0677_P00_S02 equals
        report "CASE 0677 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
    ]

