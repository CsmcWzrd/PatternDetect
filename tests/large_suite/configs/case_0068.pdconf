{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0068 pattern P00"
        log message Component084 PDET_C0068_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component084 PDET_C0068_P00_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component084 PDET_C0068_P00_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0068_P00_S02 equals
        report "CASE 0068 PATTERN P00 HIT" match:file match:line value:1status
    ]

    P01: [
        title "Case 0068 pattern P01"
        within timestamp:1a + 2678400
        log message Component001 PDET_C0068_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component001 PDET_C0068_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0068_P01_S01 equals
        report "CASE 0068 PATTERN P01 HIT" match:file match:line value:1status
    ]

    P02: [
        title "Case 0068 pattern P02"
        within timestamp:1a + 2678400
        log message Component018 PDET_C0068_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0068_P02_S00 equals
