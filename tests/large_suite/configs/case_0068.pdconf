        report "CASE 0068 PATTERN P04 HIT" match:file match:line value:1status
    ]

    P05: [
        title "Case 0068 pattern P05"
        within timestamp:1a + 2678400
        log message Component069 PDET_C0068_P05_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0068_P05_S00 equals
        report "CASE 0068 PATTERN P05 HIT" match:file match:line value:1status
