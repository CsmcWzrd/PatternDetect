{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0159 pattern P00"
        log message Component067 PDET_C0159_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component067 PDET_C0159_P00_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component067 PDET_C0159_P00_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component067 PDET_C0159_P00_S03 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component067 PDET_C0159_P00_S04 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component067 PDET_C0159_P00_S05 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component067 PDET_C0159_P00_S06 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0159_P00_S06 equals
        report "CASE 0159 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
        on-hit: P02
        on-hit: P03
        on-hit: P04
        on-hit: P05
        on-hit: P06
        on-hit: P07
    ]

    P01: [
        title "Case 0159 pattern P01"
