{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0008 pattern P00"
        log message Component004 PDET_C0008_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component004 PDET_C0008_P00_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component004 PDET_C0008_P00_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0008_P00_S02 equals
        report "CASE 0008 PATTERN P00 HIT" match:file match:line value:1status
    ]

    P01: [
        title "Case 0008 pattern P01"
        within timestamp:1a + 2678400
        log message Component021 PDET_C0008_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component021 PDET_C0008_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0008_P01_S01 equals
        report "CASE 0008 PATTERN P01 HIT" match:file match:line value:1status
    ]

    P02: [
        title "Case 0008 pattern P02"
