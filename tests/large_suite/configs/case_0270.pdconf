{
    use chronological-order
    use log-rotated
    use report-destination terminal

    P00: [
        title "Case 0270 pattern P00"
        log message Component010 PDET_C0270_P00_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0270_P00_S00 equals
        report "CASE 0270 PATTERN P00 HIT" match:file match:line value:1status
    ]

    P01: [
        title "Case 0270 pattern P01"
        within timestamp:1a + 2678400
        log message Component027 PDET_C0270_P01_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component027 PDET_C0270_P01_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component027 PDET_C0270_P01_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0270_P01_S02 equals
        report "CASE 0270 PATTERN P01 HIT" match:file match:line value:1status
    ]

    P02: [
        title "Case 0270 pattern P02"
        within timestamp:1a + 2678400
        log message Component044 PDET_C0270_P02_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component044 PDET_C0270_P02_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0270_P02_S01 equals
        report "CASE 0270 PATTERN P02 HIT" match:file match:line value:1status
    ]

    P03: [
        title "Case 0270 pattern P03"
        within timestamp:1a + 2678400
        log message Component061 PDET_C0270_P03_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0270_P03_S00 equals
        report "CASE 0270 PATTERN P03 HIT" match:file match:line value:1status
    ]

    P04: [
        title "Case 0270 pattern P04"
        within timestamp:1a + 2678400
        log message Component078 PDET_C0270_P04_S00 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component078 PDET_C0270_P04_S01 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        log message Component078 PDET_C0270_P04_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0270_P04_S02 equals
        report "CASE 0270 PATTERN P04 HIT" match:file match:line value:1status
    ]

}
