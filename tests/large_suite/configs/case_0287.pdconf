        grab timestamp:1a, value:1status, value:1tail@
        log message Component031 PDET_C0287_P00_S02 separator " "
        grab timestamp:1a, value:1status, value:1tail@
        check value:1status OK_C0287_P00_S02 equals
        report "CASE 0287 PATTERN P00 HIT" match:file match:line value:1status
        on-hit: P01
    ]

